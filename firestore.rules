rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true; }
    function admin() { return active() && me().role == 'admin'; }

    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, delete: if admin();
      allow update: if admin() || (signedIn() && request.auth.uid == uid &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']));
    }
    match /staff_credentials/{uid} { allow read, write: if admin(); }
    match /products/{id}  { allow read: if active(); allow write: if admin(); }
    match /counters/{id}  { allow read, write: if active(); }

    match /customers/{id} {
      allow read, create: if active();
      allow update: if admin() || (active() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentDue', 'orderCount', 'address']));
      allow delete: if admin();
    }
    match /orders/{id} {
      allow read: if admin() || (active() && resource.data.staffId == request.auth.uid);
      allow create: if active() && request.resource.data.staffId == request.auth.uid;
      allow update, delete: if admin();
    }
    match /transactions/{id} {
      allow read: if admin();
      allow create: if admin() || (active() && request.resource.data.type in ['add_due', 'payment']);
      allow update, delete: if admin();
    }
    match /daily_records/{id}    { allow read, write: if admin(); }
    match /employees/{id}        { allow read, write: if admin(); }
    match /salary_payments/{id}  { allow read, write: if admin(); }
  }
}
